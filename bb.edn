;; For previewing the HTML output
{:deps {org.babashka/http-server {:mvn/version "0.1.13"}}
 :paths ["src"]
 :tasks
 {:requires ([babashka.http-server :as http]
             [babashka.fs :as fs]
             [clojure.string :as str]
             [scittle-kitchen.build :as build])

  build {:doc "Make the JavaScript"
         :task (apply build/-main *command-line-args*)}

  v {:doc "Get the version"
     :task (do (build/ensure-latest-scittle)
               (println (build/kitchen-version)))}

  check-newer {:doc "Check if there's a new version to release (exit 0 if newer, 1 if not)"
               :task (do (build/ensure-latest-scittle)
                         (let [current-scittle (build/git-tag "scittle")
                               last-kitchen-tag (build/git-tag)
                               last-kitchen-scittle (when last-kitchen-tag
                                                      (first (str/split last-kitchen-tag (re-pattern "-"))))
                               is-newer? (not= current-scittle last-kitchen-scittle)]
                           (if is-newer?
                             (do (println (str "New scittle version detected: " current-scittle))
                                 (System/exit 0))
                             (do (println (str "Scittle version unchanged: " current-scittle))
                                 (System/exit 1)))))}

  check-released {:doc "Check if this version has been released to NPM (exit 0 if released, 1 if not)"
                  :task (if (build/released?)
                          (do (println (str "Already released"))
                              (System/exit 0))
                          (do (println (str "Not yet released"))
                              (System/exit 1)))}

  set-version {:doc "Set package.json"
               :task (let [v (build/kitchen-version)]
                       (shell "npm" "version" (subs v 1)
                              "--no-git-tag-version"
                              "--allow-same-version"))}

  tag {:doc "Creates and pushes a git tag to trigger release"
       :task (let [v (build/kitchen-version)]
               (shell "git" "tag" "-a" v "-m" (str "Release version " v))
               (shell "git" "push" "origin" v)
               (println "Created and pushed tag:" v))}

  release {:doc "Makes a release ready for npm publish"
           :task (do (run 'set-version)
                     (run 'build))}

  serve {:doc "Serve static assets"
         :requires ([babashka.http-server :as server])
         :task (server/exec {:port 1337
                             :dir "resources/public"})}}}
